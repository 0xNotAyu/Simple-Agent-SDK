{
  "name": "ayu-agent-sdk",
  "version": "0.1.4",
  "description": "Ayu Agent Sdk a from-scratch, provider-agnostic TypeScript AI Agent SDK with tools, handoffs, guardrails, memory, structured output, streaming, and tracing.",
  "license": "MIT",
  "author": "Aayush Sharma",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xNotAyu/ayu-agent-sdk.git"
  },
  "homepage": "https://github.com/0xNotAyu/ayu-agent-sdk#readme",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "example:basic": "tsx examples/basic-agent.ts",
    "example:handoff": "tsx examples/multi-agent-handoff.ts",
    "example:stream": "tsx examples/streaming.ts",
    "example:01": "tsx examples/01-runtime-and-tools.ts",
    "example:02": "tsx examples/02-guardrails.ts",
    "example:03": "tsx examples/03-memory-and-session.ts",
    "example:04": "tsx examples/04-structured-output.ts",
    "example:05": "tsx examples/05-streaming.ts",
    "example:06": "tsx examples/06-handoffs.ts",
    "example:07": "tsx examples/07-tracing-and-reliability.ts",
    "example:08": "tsx examples/08-provider-and-fallback.ts"
  },
  "keywords": [
    "ai-agent",
    "llm",
    "agent-sdk",
    "openai",
    "claude",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^17.4.2",
    "openai": "^4.77.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  }
}