{
  "name": "Simple-agent-sdk",
  "version": "0.1.0",
  "description": "Simple Agent SDK provider-agnostic TypeScript AI Agent SDK with tools, handoffs, guardrails, memory, structured output, streaming, and tracing.",
  "license": "MIT",
  "author": "Aayush Sharma",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "example:basic": "tsx examples/basic-agent.ts",
    "example:handoff": "tsx examples/multi-agent-handoff.ts",
    "example:stream": "tsx examples/streaming.ts"
  },
  "keywords": [
    "ai-agent",
    "llm",
    "agent-sdk",
    "openai",
    "claude",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^17.4.2",
    "node": "^26.5.1",
    "openai": "^4.77.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  }
}
